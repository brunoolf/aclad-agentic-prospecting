{
  "description": "Optional private-state recovery and checkpoint reinforcement.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"${PLUGIN_ROOT}/runtime\" python3 -m aclad.hooks --surface codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"${PLUGIN_ROOT}/runtime\" python3 -m aclad.hooks --surface codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"${PLUGIN_ROOT}/runtime\" python3 -m aclad.hooks --surface codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"${PLUGIN_ROOT}/runtime\" python3 -m aclad.hooks --surface codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"${PLUGIN_ROOT}/runtime\" python3 -m aclad.hooks --surface codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"${PLUGIN_ROOT}/runtime\" python3 -m aclad.hooks --surface codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"${PLUGIN_ROOT}/runtime\" python3 -m aclad.hooks --surface codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
